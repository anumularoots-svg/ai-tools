{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), display-capture=(self), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate, s-maxage=86400, stale-while-revalidate=604800"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://unpkg.com https://www.googletagmanager.com https://cdn.vercel-insights.com https://va.vercel-scripts.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob:; worker-src 'self' blob: https://cdnjs.cloudflare.com; manifest-src 'self'; connect-src 'self' https://www.google-analytics.com https://cdn.vercel-insights.com https://vitals.vercel-insights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ],
  "functions": {
    "api/pdf.js": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/docx.js": {
      "maxDuration": 15
    },
    "api/generate.js": {
      "maxDuration": 60
    },
    "api/tool.js": {
      "maxDuration": 60
    },
    "api/interview.js": {
      "maxDuration": 60
    },
    "api/ats.js": {
      "maxDuration": 30
    },
    "api/tailor.js": {
      "maxDuration": 60
    },
    "api/jobs.js": {
      "maxDuration": 60
    }
  },
  "network": {
    "egressAllowList": [
      "api.adzuna.com",
      "api.groq.com",
      "generativelanguage.googleapis.com",
      "openrouter.ai",
      "api.cerebras.ai",
      "boards-api.greenhouse.io",
      "api.lever.co",
      "data.usajobs.gov",
      "in.indeed.com"
    ]
  },
  "crons": [
    {
      "path": "/api/jobs?action=cron",
      "schedule": "0 6 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/career",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/t/:slug",
      "destination": "/tool"
    },
    {
      "source": "/t/:slug/",
      "destination": "/tool"
    }
  ]
}