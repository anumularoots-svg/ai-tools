{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "functions": {
    "api/pdf.js": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/docx.js": {
      "maxDuration": 15
    },
    "api/generate.js": {
      "maxDuration": 60
    },
    "api/tool.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/t/(.*)", "destination": "/tool.html" }
  ]
}
