{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResumeGPT Universal Resume Schema v1",
  "description": "AI must return ONLY this JSON structure. Application controls all formatting, layout, and PDF rendering.",
  "type": "object",
  "required": ["personal", "summary", "skills", "experience", "education"],
  "properties": {
    "personal": {
      "type": "object",
      "required": ["fullName", "title", "email", "phone", "location"],
      "properties": {
        "fullName": { "type": "string", "description": "Candidate full name exactly as provided" },
        "title": { "type": "string", "description": "Target job title / designation" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "location": { "type": "string" },
        "linkedin": { "type": "string" },
        "github": { "type": "string" },
        "portfolio": { "type": "string" }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 200,
      "maxLength": 800,
      "description": "Professional summary. 4-7 sentences. Must include: years of experience, core technologies, domain, one quantified achievement."
    },
    "skills": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["category", "items"],
        "properties": {
          "category": { "type": "string", "description": "e.g. Cloud — AWS, CI/CD & GitOps, Security" },
          "items": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 2,
            "description": "Individual skills: EKS, ECS, EC2, S3"
          }
        }
      }
    },
    "achievements": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["text", "metric"],
        "properties": {
          "text": { "type": "string", "description": "Achievement bullet starting with power verb" },
          "metric": { "type": "string", "description": "The quantified part: 60%, $2M, 40% faster, etc." }
        }
      }
    },
    "experience": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "company", "location", "startDate", "endDate", "bullets"],
        "properties": {
          "title": { "type": "string", "description": "Job title exactly as provided by candidate" },
          "company": { "type": "string", "description": "Company name exactly as provided" },
          "location": { "type": "string" },
          "startDate": { "type": "string", "description": "e.g. Jan 2023" },
          "endDate": { "type": "string", "description": "e.g. Present, Nov 2022" },
          "bullets": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "required": ["text"],
              "properties": {
                "text": { "type": "string", "description": "STAR format bullet. Must start with power verb." },
                "technologies": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Technologies mentioned in this bullet"
                }
              }
            }
          }
        }
      }
    },
    "education": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["degree", "institution", "year"],
        "properties": {
          "degree": { "type": "string" },
          "institution": { "type": "string" },
          "year": { "type": "string" },
          "gpa": { "type": "string" },
          "honors": { "type": "string" }
        }
      }
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "issuer": { "type": "string" },
          "year": { "type": "string" },
          "status": { "type": "string", "enum": ["completed", "in-progress", "target"] }
        }
      }
    },
    "strengths": {
      "type": "array",
      "minItems": 5,
      "maxItems": 10,
      "items": { "type": "string" }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "language": { "type": "string" },
          "proficiency": { "type": "string", "enum": ["native", "fluent", "professional", "intermediate", "basic"] }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description", "technologies"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "technologies": { "type": "array", "items": { "type": "string" } },
          "bullets": { "type": "array", "items": { "type": "string" } },
          "url": { "type": "string" }
        }
      }
    }
  }
}
